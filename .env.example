# ==============================================================================
# SOLANA PREDATOR — Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Core Application
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DATABASE_PATH=solana_predator.db
ADMIN_API_KEY=predator_dev_key_replace_in_prod

# Solana RPC Endpoints (Read-Only)
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS=wss://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed
RPC_TIMEOUT_SECONDS=10.0

# Paper Trading & Risk Parameters
PAPER_INITIAL_CAPITAL_USD=10000.0
PAPER_MAX_POSITION_PCT=0.10
PAPER_MAX_OPEN_POSITIONS=5
PAPER_MAX_DRAWDOWN_VETO_PCT=0.15
DATA_STALENESS_THRESHOLD_SEC=30.0

# LLM Provider Configuration (OpenAI Chat Completions Compatible)
# Target Model: glm-5.3-flash
LLM_ENABLED=false
LLM_PROVIDER=space_z
LLM_API_BASE_URL=https://preview-chat-5b88a64e-2cfd-4430-8a11-8a8190f3f6b2.space-z.ai/api/provider/v1
LLM_API_KEY=sk-placeholder-do-not-commit
LLM_MODEL=glm-5.3-flash
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=5
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_STREAM=false
LLM_AUTH_HEADER_STYLE=bearer
